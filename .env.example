# =============================================
# Environment Variables - Example / Template
# =============================================
# העתיקו קובץ זה ל-.env ומלאו את הערכים האמיתיים.
# אסור להעלות את .env ל-Git (מוגדר ב-.gitignore).

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- OpenAI (אופציונלי - אם נשתמש במודלים נוספים) ---
OPENAI_API_KEY=your-openai-api-key-here

# --- יצירת תמונות (יובל) ---
# למשל: Replicate, Stability, DALL-E וכו'
IMAGE_API_KEY=your-image-api-key-here

# --- מחקר (חן) ---
# למשל: Tavily, Serper, Perplexity וכו'
SEARCH_API_KEY=your-search-api-key-here

# --- כללי ---
PROJECT_NAME=5agents
ENVIRONMENT=development
